// Web tự học bản tĩnh ở https://bibaplay.com — Workers Static Assets + worker (worker.js) chạy trước mọi request.
// Thư mục assets do hoc/xuat-web.py sinh ra (build/ đã gitignore); deploy bằng hoc/deploy-web.sh.
// custom_domain: Cloudflare tự tạo DNS + SSL lúc deploy lần đầu. Gỡ route ở đây KHÔNG tự xoá domain
// trên Cloudflare — phải xoá tay ở Workers → Settings → Domains.
{
  "name": "ban-rap-hoc",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  // binding ASSETS: thiếu thì worker nuốt mọi request, trang tĩnh chết
  // run_worker_first: không có thì file tĩnh được phát thẳng, redirect www/domain cũ trong worker.js không chạy
  // not_found_handling: đường dẫn lạ → 404.html (mã 404) thay vì trang trắng; route thật đều có <route>/index.html
  "assets": { "directory": "../build/hoc-web", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
  "r2_buckets": [{ "binding": "PDF", "bucket_name": "ban-rap-hoc" }],
  // Bảng đếm tạo một lần: wrangler d1 execute ban-rap-hoc --remote --command
  //   "CREATE TABLE IF NOT EXISTS dem (k TEXT PRIMARY KEY, n INTEGER NOT NULL); INSERT OR IGNORE INTO dem VALUES ('xem', 0)"
  //   "CREATE TABLE IF NOT EXISTS xem_ngay (ngay TEXT PRIMARY KEY, n INTEGER NOT NULL)"
  "d1_databases": [{ "binding": "DB", "database_name": "ban-rap-hoc", "database_id": "5fd04316-979f-405c-9363-8e1a4920abea" }],
  "routes": [
    { "pattern": "bibaplay.com", "custom_domain": true },
    { "pattern": "www.bibaplay.com", "custom_domain": true },
    // domain cũ: worker.js chuyển 301 về bibaplay.com để link đã gửi anh em không chết
    { "pattern": "hoc.talesofascension.com", "custom_domain": true }
  ]
}
